generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  passwordHash     String
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  mustChangePassword Boolean @default(true) // force a password change on first login
  isActive         Boolean  @default(true)  // admin can deactivate without deleting
  failedLoginAttempts Int    @default(0)
  lockedUntil      DateTime?                 // set after 5 failed attempts; auto-clears
  role             String   @default("USER") // ADMIN, USER
  defaultUsdRate   Float    @default(25400)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // INVOICE (Income), COST (Expense)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  invoices     Invoice[]
}

// A place money sits: a bank account, company cash, the owner's pocket
// (owner-paid expenses; a negative balance = owed to the owner), or a term deposit.
model Account {
  id             String    @id @default(cuid())
  name           String
  type           String    @default("BANK") // BANK, CASH, OWNER, TERM_DEPOSIT
  currency       String    @default("VND")  // VND or USD
  openingBalance Float     @default(0)      // in the account's own currency
  openingDate    DateTime?                  // movements before this date are already in the opening balance
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions   Transaction[]
  statements     BankStatement[]
  bankLines      BankLine[]
}

// An imported bank statement file. New lines are appended only after
// de-duplication, and only if the file adds up: opening + in − out = closing.
model BankStatement {
  id             String     @id @default(cuid())
  accountId      String
  account        Account    @relation(fields: [accountId], references: [id])
  fileName       String
  periodFrom     DateTime
  periodTo       DateTime
  openingBalance Float      // as stated, in the account's currency
  closingBalance Float
  inflows        Float
  outflows       Float
  lineCount      Int        // lines in the file (duplicates included)
  importedBy     String?
  createdAt      DateTime   @default(now())
  lines          BankLine[]
}

// One line of a bank statement, kept exactly as the bank reported it.
model BankLine {
  id           String        @id @default(cuid())
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  statementId  String
  statement    BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  txnDate      DateTime      // transaction date
  postingDate  DateTime?     // posting date — kept separately
  reference    String?       // bank transaction reference
  amount       Float         // + money in, − money out, in the account's currency
  balance      Float?        // running balance as printed
  counterparty String?
  description  String?
  locator      String        // file · sheet · row
  dedupeKey    String        // reference | date | amount (+ repeat number within the file)
  entries      Transaction[] // ledger entries this line is reconciled to
  createdAt    DateTime      @default(now())

  @@unique([accountId, dedupeKey])
}

// Change history: who changed what, when and why — one row per changed field.
// Not linked by foreign key, so the history of a deleted entry is kept.
model ChangeLog {
  id        String   @id @default(cuid())
  entity    String   @default("Transaction")
  entityId  String
  action    String   // CREATE, UPDATE, REVIEW, POST, REVERSE, DELETE, MATCH, UNMATCH, LINK, UNLINK
  field     String?
  oldValue  String?
  newValue  String?
  reason    String?
  user      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// A loan to the company (e.g. from the owner). Outstanding = received − repaid.
model Loan {
  id        String   @id @default(cuid())
  lender    String
  currency  String   @default("VND")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  date          DateTime
  // INCOME, EXPENSE (profit & loss) · TRANSFER_OUT, TRANSFER_IN · CAPITAL_IN ·
  // LOAN_IN, LOAN_REPAY · OTHER_IN, OTHER_OUT (not yet classified)
  type          String
  currency      String   @default("VND") // original currency of the amount: VND or USD
  exchangeRate  Float    @default(1.0)   // VND per unit of currency
  vndAmount     Float?                   // exact VND actually settled, when known (bank statement)
  rateSource    String?                  // BANK, MANUAL, DEFAULT; null for VND amounts
  amount        Float
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id])
  transferId    String?                  // shared by the two legs of an internal transfer
  loanId        String?
  loan          Loan?     @relation(fields: [loanId], references: [id])
  description   String?
  invoiceNumber String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  invoiceId     String?   @unique // legacy one-to-one link; payments now go through PaymentAllocation
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])
  allocations   PaymentAllocation[]
  // Evidence and tax review (income/expense) — separate from bookkeeping.
  // Recording an expense never makes it deductible or its VAT claimable.
  docStatus     String    @default("PENDING") // PENDING, INVOICE, RECEIPT, PAYMENT_ONLY, MISSING
  purposeStatus String    @default("PENDING") // PENDING, CONFIRMED, PERSONAL (expenses)
  citStatus     String    @default("PENDING") // PENDING, DEDUCTIBLE, NON_DEDUCTIBLE (expenses)
  vatStatus     String    @default("PENDING") // PENDING, CLAIMABLE, NOT_CLAIMABLE, NO_VAT (expenses)
  vatAmount     Float?                        // input VAT as printed on the invoice, in `currency`
  reviewNote    String?                       // purpose evidence, the accountant's basis, open questions
  bankLineId    String?                       // the bank statement line this entry is reconciled to
  bankLine      BankLine? @relation(fields: [bankLineId], references: [id], onDelete: SetNull)
  // Workflow: staff entries start as drafts; an admin reviews, then posts.
  // Posted entries are locked — corrected by a reversal, never edited away.
  status         String       @default("REVIEWED") // DRAFT, REVIEWED, POSTED
  createdBy      String?                           // who entered it
  reversalOfId   String?      @unique              // this entry cancels that posted entry in full
  reversalOf     Transaction? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy     Transaction? @relation("Reversal")
  correctionOfId String?                           // re-entered in place of that reversed entry
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attachments   Attachment[]
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  invoices     Invoice[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  invoices  Invoice[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("ACTIVE") // ACTIVE, DONE, ARCHIVED
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  description String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  invoices     Invoice[]
  attachments  Attachment[]
}

model Invoice {
  id           String    @id @default(cuid())
  number       String?   // number from the externally-issued PDF (optional)
  direction    String    @default("RECEIVABLE") // RECEIVABLE = client owes me (AR); PAYABLE = I owe a vendor (AP)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  vendorId     String?
  vendor       Vendor?   @relation(fields: [vendorId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  issueDate    DateTime
  dueDate      DateTime
  currency     String    @default("VND")
  exchangeRate Float     @default(1.0)
  amount       Float
  status       String    @default("OPEN") // OPEN, PARTIAL, PAID (derived from allocations), VOID
  paidDate     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transaction  Transaction? // legacy one-to-one payment link
  allocations  PaymentAllocation[]
  attachments  Attachment[] // the real invoice/bill PDF
}

// Links a payment — or a separately evidenced fee — to an invoice/bill. One
// invoice can have many payments; one payment can settle many invoices.
// gross − payments − evidenced fees = the unmatched difference, which is shown,
// never silently treated as a fee.
model PaymentAllocation {
  id            String      @id @default(cuid())
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  kind          String      @default("PAYMENT") // PAYMENT, FEE
  amount        Float       // in the invoice's currency
  createdAt     DateTime    @default(now())

  @@unique([invoiceId, transactionId])
}

model Attachment {
  id            String   @id @default(cuid())
  filePath      String
  fileType      String
  fileName      String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model BankBalance {
  id          String   @id @default(cuid())
  type        String   @default("DEPOSIT") // OPENING, DEPOSIT, WITHDRAWAL
  amount      Float    @default(0)         // positive; sign is implied by type
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UnitRate {
  id          String   @id @default(cuid())
  description String
  rate        Float
  unit        String   // hours, project, manday
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
